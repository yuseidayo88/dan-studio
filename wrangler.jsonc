{
  "name": "dan-studio",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dan-studio-orders",
      "database_id": "3d89eccb-8427-4cb7-b44d-159c4c7331b3"
    }
  ]
}
